# ==============================================================================
# DocuVideo RAG - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' before running the application:
#    cp .env.example .env   (Linux/macOS)
#    copy .env.example .env (Windows PowerShell/CMD)
# 2. Modify the configuration values below to match your environment.
# 3. IMPORTANT: Never commit your actual '.env' file containing private keys to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STREAMLIT APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Port and bind address for the Streamlit web dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_THEME_BASE=dark

# ------------------------------------------------------------------------------
# 2. RETRIEVAL-AUGMENTED GENERATION (RAG) CONFIGURATION
# ------------------------------------------------------------------------------
# Character chunk size and overlap for document sliding window extraction
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=75

# Default, minimum, and maximum slide presentation counts
RAG_DEFAULT_SLIDES=4
RAG_MIN_SLIDES=3
RAG_MAX_SLIDES=6

# Local ChromaDB persistence directory (leave blank for in-memory execution)
CHROMA_PERSIST_DIRECTORY=./temp/chromadb

# ------------------------------------------------------------------------------
# 3. PRESENTATION SLIDE RENDERING (1080p HD)
# ------------------------------------------------------------------------------
# Slide canvas dimensions in pixels (Full HD 16:9 recommended)
SLIDE_WIDTH=1920
SLIDE_HEIGHT=1080

# Preferred Windows typography (defaults to Segoe UI / Arial)
SLIDE_FONT_REGULAR=segoeui.ttf
SLIDE_FONT_BOLD=segeouib.ttf

# ------------------------------------------------------------------------------
# 4. OFFLINE VOICE NARRATION (WINDOWS SAPI5 TTS)
# ------------------------------------------------------------------------------
# Voice index (0 = default system voice, 1 = secondary installed voice)
TTS_VOICE_INDEX=0

# Speech rate: integer from -10 (slowest) to +10 (fastest), default 0 (normal)
TTS_SPEECH_RATE=0

# Speech volume: integer from 0 (mute) to 100 (maximum)
TTS_VOLUME=100

# ------------------------------------------------------------------------------
# 5. VIDEO TIMELINE & COMPOSITION SETTINGS
# ------------------------------------------------------------------------------
# Target frame rate for video rendering (12-24 fps optimal for slide presentations)
VIDEO_FPS=12

# Crossfade / fade-in transition duration between consecutive slides (seconds)
VIDEO_TRANSITION_DURATION=0.3

# Video and audio encoding codecs for MoviePy export
VIDEO_CODEC=libx264
AUDIO_CODEC=aac

# ------------------------------------------------------------------------------
# 6. DIRECTORY & STORAGE PATHS
# ------------------------------------------------------------------------------
OUTPUT_DIR=./output
SLIDES_OUTPUT_DIR=./output/slides
AUDIO_OUTPUT_DIR=./output/audio
VIDEOS_OUTPUT_DIR=./output/videos
TEMP_DIR=./temp


